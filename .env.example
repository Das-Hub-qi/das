# Yerel bilgisayarda çalıştırmak için bu dosyayı ".env" adıyla kopyalayıp doldurun.
# GitHub Actions'ta bu değerler Settings > Secrets and variables > Actions bölümüne eklenir.
ANTHROPIC_API_KEY=
YOUTUBE_API_KEY=
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
PEXELS_API_KEY=
PIXABAY_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CF_KV_NAMESPACE_ID=
# İsteğe bağlı: tekliflere otomatik e-posta yanıtı (Gmail için uygulama şifresi)
SMTP_SUNUCU=smtp.gmail.com
SMTP_PORT=465
SMTP_KULLANICI=
SMTP_SIFRE=
